# Provider options: groq, openrouter, nvidia, gemini, ollama, openai
SOVA_PROVIDER=openrouter

# Leave blank to use provider default, or specify a model (e.g. meta-llama/llama-3.3-70b-instruct:free)
SOVA_MODEL=meta-llama/llama-3.3-70b-instruct:free

# --- Provider API Keys ---
# OpenRouter (Free models available: meta-llama/llama-3.3-70b-instruct:free, deepseek/deepseek-r1:free, etc.)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Groq (Free tier available at console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# Nvidia NIM (Free developer credits at build.nvidia.com)
NVIDIA_API_KEY=your_nvidia_api_key_here

# Google Gemini (Free tier at aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Ollama (Local offline - 100% free)
SOVA_OLLAMA_HOST=http://localhost:11434

# OpenAI (Optional paid)
OPENAI_API_KEY=your_openai_api_key_here
